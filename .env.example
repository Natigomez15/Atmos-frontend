# ATMOS Frontend - Configuración de Variables de Entorno
# ═════════════════════════════════════════════════════════════════════════════
#
# IMPORTANTE: Nunca subir .env a Git. Usar .env.example como plantilla.
# En Vercel: Settings > Environment Variables

# ── API REST (para llamadas HTTP con fetch/axios) ──────────────────────────
# Usar HTTPS en producción, HTTP en local
# Uso: /notificaciones/*, /alerts/*, /ml/*, /reports/*, /lecturas/*, etc.
VITE_API_URL=http://localhost:8000/api/v1

# ── API Key (opcional, para algunos endpoints sin autenticación) ────────────
VITE_API_KEY=your_admin_api_key_here

# ── WebSocket (SOLO para WebSocket, NO para fetch) ────────────────────────
# Usar WSS en producción, WS en local
# Uso: /ws/alerts (alertas en vivo), /ws/rooms/{id} (lecturas en vivo)
# NUNCA hacer fetch() a VITE_WS_URL — eso causará error "wss is not supported"
VITE_WS_URL=ws://localhost:8000/api/v1

# ── Supabase (Base de datos y autenticación) ────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ═════════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN PARA PRODUCCIÓN
# ═════════════════════════════════════════════════════════════════════════════
# Para Vercel/Render, copiar en Environment Variables:
#
# VITE_API_URL=https://atmos-backend-slno.onrender.com/api/v1
# VITE_WS_URL=wss://atmos-backend-slno.onrender.com/api/v1
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
